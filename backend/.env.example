# Backend environment variables. The `local` profile (default) already points at `docker compose up -d db`,
# so none of these are needed for local development.

# Spring profile: `local` (default) or `prod`
SPRING_PROFILES_ACTIVE=local

# PostgreSQL — JDBC form. Neon: use the *direct* (non-pooled) host and sslmode=require, e.g.
#   jdbc:postgresql://ep-example-123456.eu-central-1.aws.neon.tech/parallaxcrm?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5433/parallaxcrm
DATABASE_USERNAME=parallax
DATABASE_PASSWORD=parallax
DATABASE_POOL_SIZE=5

# Swagger UI + /v3/api-docs (default: on locally, off in prod)
OPENAPI_ENABLED=true

# HTTP port (Render sets this automatically)
PORT=8080
